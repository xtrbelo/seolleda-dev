rules_version = '2';

service cloud.firestore {
  // =============================================================
  // Modelo assumido
  // =============================================================
  // products: catálogo, preços, situação e timestamps.
  // productKeys: chaves únicas internas de SKU/código de barras.
  // categories: nome normalizado, descrição, situação e timestamps.
  // stores: nome (2–120), endereço (0–300), contato (0–120), situação e timestamps.
  // terminals: nome, storeId, situação e timestamps.
  // inventory: storeId, productId, quantidades física/reservada/mínima e timestamps.
  // stockMovements: loja, produto, operação, saldos, motivo, autor e timestamp.
  // sales: loja, terminal, cliente, itens, pagamento, reserva e timestamps.
  // Demais coleções operacionais e de auditoria são exclusivas do backend.
  // =============================================================
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isMaster() {
      return isAuthenticated()
        && request.auth.token.roles is list
        && request.auth.token.roles.hasAny(['master']);
    }

    function isAdministrator() {
      return isAuthenticated()
        && (('admin' in request.auth.token
            && request.auth.token.admin == true)
          || (request.auth.token.roles is list
            && request.auth.token.roles.hasAny(['admin'])));
    }

    function hasRole(role) {
      return isMaster()
        || (isAdministrator() && role != 'settings')
        || (!isAdministrator() && isAuthenticated()
          && request.auth.token.roles is list
          && request.auth.token.roles.hasAny([role]));
    }

    function hasStore(storeId) {
      return isMaster()
        || isAdministrator()
        || (isAuthenticated()
          && request.auth.token.storeIds is list
          && request.auth.token.storeIds.hasAny([storeId]));
    }

    function canCatalog() { return hasRole('catalog'); }
    function canInventory() { return hasRole('inventory'); }
    function canSales() { return hasRole('sales'); }
    function canReports() { return hasRole('reports'); }
    function canSettings() { return hasRole('settings'); }

    function validString(value, minimum, maximum) {
      return value is string
        && value.size() >= minimum
        && value.size() <= maximum;
    }

    function validProduct(data) {
      return data.keys().hasOnly([
          'name', 'normalizedName', 'description', 'sku', 'normalizedSku',
          'barcode', 'categoryId', 'categoryName', 'costPrice', 'salePrice',
          'active', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'name', 'normalizedName', 'description', 'sku', 'normalizedSku',
          'barcode', 'categoryId', 'categoryName', 'costPrice', 'salePrice',
          'active', 'createdAt', 'updatedAt'
        ])
        && validString(data.name, 2, 120)
        && validString(data.normalizedName, 2, 120)
        && data.description is string && data.description.size() <= 2000
        && validString(data.sku, 1, 64)
        && validString(data.normalizedSku, 1, 64)
        && validString(data.barcode, 1, 64)
        && validString(data.categoryId, 1, 128)
        && validString(data.categoryName, 1, 120)
        && data.costPrice is number
        && data.costPrice >= 0 && data.costPrice <= 1000000000
        && data.salePrice is number
        && data.salePrice >= 0 && data.salePrice <= 1000000000
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validCategory(data) {
      return data.keys().hasOnly([
          'name', 'normalizedName', 'description', 'active',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'name', 'normalizedName', 'description', 'active',
          'createdAt', 'updatedAt'
        ])
        && validString(data.name, 2, 120)
        && validString(data.normalizedName, 2, 120)
        && data.description is string
        && data.description.size() <= 2000
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt == request.time
        && (resource == null
          || data.createdAt == resource.data.createdAt);
    }

    match /products/{productId} {
      allow read: if canCatalog() || canReports() || canInventory() || canSales();
      allow create, update, delete: if false;
    }

    match /productKeys/{keyId} {
      allow read, write: if false;
    }

    match /categories/{categoryId} {
      allow read: if canCatalog() || canReports() || canInventory() || canSales();
      allow create, update: if canCatalog() && validCategory(request.resource.data);
      allow delete: if canCatalog();
    }

    match /stores/{storeId} {
      allow read: if canSettings()
        || ((canInventory() || canReports()) && hasStore(storeId));
      allow create, update, delete: if false;
    }

    match /inventory/{inventoryId} {
      allow read: if (canInventory() || canReports()) && hasStore(resource.data.storeId);
      allow create, update, delete: if false;
    }

    match /stockMovements/{movementId} {
      allow read: if (canInventory() || canSales() || canReports()) && hasStore(resource.data.storeId);
      allow create, update, delete: if false;
    }

    match /terminals/{terminalId} {
      allow read, write: if false;
    }

    match /sales/{saleId} {
      allow read: if false;
      allow create, update, delete: if false;
    }
  }
}
