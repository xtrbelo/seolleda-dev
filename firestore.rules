rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isAuthenticated()
        && (request.auth.token.admin == true
          || (request.auth.token.roles is list && request.auth.token.roles.hasAny([role, 'admin'])));
    }

    function canCatalog() { return hasRole('catalog'); }
    function canInventory() { return hasRole('inventory'); }
    function canSales() { return hasRole('sales'); }
    function canReports() { return hasRole('reports'); }
    function canSettings() { return hasRole('settings'); }

    function validString(value, minimum, maximum) {
      return value is string
        && value.size() >= minimum
        && value.size() <= maximum;
    }

    function validProduct(data) {
      return data.keys().hasOnly([
          'name', 'normalizedName', 'description', 'sku', 'normalizedSku',
          'barcode', 'categoryId', 'categoryName', 'costPrice', 'salePrice',
          'active', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll([
          'name', 'normalizedName', 'description', 'sku', 'normalizedSku',
          'barcode', 'categoryId', 'categoryName', 'costPrice', 'salePrice',
          'active', 'createdAt', 'updatedAt'
        ])
        && validString(data.name, 2, 120)
        && validString(data.normalizedName, 2, 120)
        && data.description is string && data.description.size() <= 2000
        && validString(data.sku, 1, 64)
        && validString(data.normalizedSku, 1, 64)
        && validString(data.barcode, 1, 64)
        && validString(data.categoryId, 1, 128)
        && validString(data.categoryName, 1, 120)
        && data.costPrice is number
        && data.costPrice >= 0 && data.costPrice <= 1000000000
        && data.salePrice is number
        && data.salePrice >= 0 && data.salePrice <= 1000000000
        && data.active is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /products/{productId} {
      allow read: if canCatalog() || canReports() || canInventory() || canSales();
      allow create, update, delete: if false;
    }

    match /productKeys/{keyId} {
      allow read, write: if false;
    }

    match /categories/{categoryId} {
      allow read: if canCatalog() || canReports() || canInventory() || canSales();
      allow create, update: if canCatalog()
        && request.resource.data.keys().hasOnly([
          'name', 'normalizedName', 'description', 'active',
          'createdAt', 'updatedAt'
        ])
        && validString(request.resource.data.name, 2, 120)
        && validString(request.resource.data.normalizedName, 2, 120)
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.active is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt == request.time
        && (resource == null
          || request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if canCatalog();
    }

    match /stores/{storeId} {
      allow read: if canSettings() || canInventory() || canReports();
      allow create, update: if canSettings()
        && request.resource.data.keys().hasOnly([
          'name', 'active', 'createdAt', 'updatedAt'
        ])
        && validString(request.resource.data.name, 2, 120)
        && request.resource.data.active is bool
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt == request.time
        && (resource == null
          || request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if canSettings();
    }

    match /inventory/{inventoryId} {
      allow read: if canInventory() || canReports();
      allow create, update, delete: if false;
    }

    match /stockMovements/{movementId} {
      allow read: if canInventory() || canSales() || canReports();
      allow create, update, delete: if false;
    }

    match /terminals/{terminalId} {
      allow read, write: if false;
    }

    match /sales/{saleId} {
      allow read: if false;
      allow create, update, delete: if false;
    }
  }
}
